@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+const source = await readFile(
+  new URL(
+    '../src/engine/core-modules/workspace-invitation/services/workspace-invitation.service.ts',
+    import.meta.url,
+  ),
+  'utf8',
+);
+const accessDomainSource = await readFile(
+  new URL(
+    '../src/engine/core-modules/approved-access-domain/services/approved-access-domain.service.ts',
+    import.meta.url,
+  ),
+  'utf8',
+);
+assert.match(source, /CLIENT_EMAIL_BRANDING\.productName/);
+assert.match(source, /CLIENT_EMAIL_BRANDING\.invitation\.subject/);
+assert.doesNotMatch(source, /\(via Twenty\)/);
+assert.doesNotMatch(source, /Join your team on Twenty/);
+assert.match(accessDomainSource, /CLIENT_EMAIL_BRANDING\.productName/);
+assert.doesNotMatch(accessDomainSource, /\(via Twenty\)/);
+console.log('PASS: invitation sender and subject use centralized MK5 branding');
