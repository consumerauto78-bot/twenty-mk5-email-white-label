@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import { SendInviteLinkEmail, renderEmail, PasswordResetLinkEmail, PasswordUpdateNotifyEmail, SendEmailVerificationLinkEmail } from '../dist/index.js';
+
+const render = (component) => renderEmail(component);
+const invitation = await render(SendInviteLinkEmail({
+  link: 'https://example.test/invite?token=redacted',
+  workspace: { name: 'MK5 Dealer Intelligence', logo: undefined },
+  sender: { email: 'inviter@example.test', firstName: 'Inviter', lastName: 'Example' },
+  serverUrl: 'https://example.test', locale: 'en',
+}));
+const reset = await render(PasswordResetLinkEmail({ duration: '24 hours', hasPassword: true, link: 'https://example.test/reset', locale: 'en' }));
+const changed = await render(PasswordUpdateNotifyEmail({ userName: 'Example', email: 'operator@example.test', link: 'https://example.test', locale: 'en' }));
+const verification = await render(SendEmailVerificationLinkEmail({ link: 'https://example.test/verify', locale: 'en' }));
+for (const html of [invitation, reset, changed, verification]) {
+  assert.match(html, /MK5 Dealer Intelligence/);
+  assert.doesNotMatch(html, /app\.twenty\.com|twentyhq\/twenty|docs\.twenty\.com|Twenty logo/i);
+}
+assert.match(invitation, /Accept Invitation/);
+assert.match(invitation, /You(?:&apos;|&#x27;|')ve been invited to MK5 Dealer Intelligence/);
+assert.doesNotMatch(invitation, /Join your team on Twenty|via Twenty/i);
+assert.doesNotMatch(invitation, /twenty\.com/i);
+assert.match(changed, /Open MK5 Dealer Intelligence/);
+assert.match(verification, /MK5 Dealer Intelligence/);
+console.log('PASS: MK5 client-facing transactional-email render checks');
